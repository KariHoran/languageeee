{
  "name": "languageeee",
  "version": "1.0.0",
  "main": "expo/AppEntry.js",
  "private": true,
  "engines": {
    "node": "24.x"
  },
  "scripts": {
  "start": "expo start",
  "dev": "expo start --web",
  "build": "expo export -p web",
    "start": "expo start --offline",
    "android": "expo start --android --offline",
    "ios": "expo start --ios --offline",
    "web": "npm run build:css && expo start --web --offline",
    "web:clear": "npm run build:css && expo start --web --offline --clear",
    "build:css": "tailwindcss -i ./src/styles/global.css -o ./src/styles/global.generated.css --minify",
    "export:web": "npm run build:css && expo export -p web",
    "vercel-build": "npm run export:web && node scripts/spaFallback.js",
    "build:pwa": "npm run export:web",
    "firebase:rules": "npx firebase-tools deploy --only firestore:rules"
  },
  "dependencies": {
    "@babel/core": "^7.25.2",
    "@expo/metro-runtime": "~5.0.5",
    "@pinyin-pro/data": "^1.3.1",
    "@react-native-async-storage/async-storage": "2.1.2",
    "autoprefixer": "^10.5.4",
    "expo": "~53.0.0",
    "expo-constants": "~17.1.8",
    "expo-speech": "~13.1.7",
    "expo-status-bar": "~2.2.3",
    "firebase": "11.10.0",
    "openai": "^4.77.0",
    "opencc-js": "^1.4.1",
    "pinyin-pro": "^3.28.2",
    "postcss": "^8.5.25",
    "react": "19.0.0",
    "react-dom": "19.0.0",
    "react-native": "0.79.2",
    "react-native-safe-area-context": "^5.4.0",
    "react-native-web": "^0.20.0",
    "tailwindcss": "^3.4.19",
    "typescript": "~5.8.3",
    "zustand": "^5.0.14"
  },
  "devDependencies": {
    "@types/react": "~19.0.10"
  }
}
