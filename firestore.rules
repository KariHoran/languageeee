rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    /** Владелец пути users/{userId} */
    function isPathOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    /**
     * Владелец документа: auth.uid === resource.data.userId
     * (обязательное поле RBAC для books / collections / publicCollections).
     */
    function isDocOwner() {
      return isSignedIn()
        && resource.data.keys().hasAny(['userId'])
        && resource.data.userId == request.auth.uid;
    }

    /** create: userId должен быть текущим auth.uid */
    function createWithOwnUserId() {
      return isSignedIn()
        && request.resource.data.keys().hasAny(['userId'])
        && request.resource.data.userId == request.auth.uid;
    }

    /** update: нельзя сменить владельца */
    function keepsOwnUserId() {
      return request.resource.data.userId == request.auth.uid
        && request.resource.data.userId == resource.data.userId;
    }

    /** Родительская публичная подборка доступна для чтения */
    function publicCollectionReadable(slug) {
      return isSignedIn()
        && get(/databases/$(database)/documents/publicCollections/$(slug)).data.isPublic == true;
    }

    function publicCollectionOwned(slug) {
      return isSignedIn()
        && get(/databases/$(database)/documents/publicCollections/$(slug)).data.userId
             == request.auth.uid;
    }

    /**
     * Приватные данные: users/{uid}/…
     * Профиль — только владелец пути.
     */
    match /users/{userId} {
      allow read, write: if isPathOwner(userId);

      /**
       * Подборки (collections):
       * - read: только авторизованные; свои или isPublic
       * - create: auth + userId == auth.uid
       * - update/delete: только владелец (userId)
       */
      match /collections/{collectionId} {
        allow read: if isSignedIn()
          && (
            isPathOwner(userId)
            || resource.data.isPublic == true
          );

        allow create: if isPathOwner(userId)
          && createWithOwnUserId();

        allow update: if isDocOwner() && keepsOwnUserId();

        allow delete: if isDocOwner();
      }

      /**
       * Фанфики / книги (books):
       * - read/write только авторизованному владельцу пути
       * - create с userId == auth.uid
       * - update/delete строго по resource.data.userId
       */
      match /books/{bookId} {
        allow read: if isSignedIn() && isPathOwner(userId);

        allow create: if isPathOwner(userId)
          && createWithOwnUserId();

        allow update: if isDocOwner() && keepsOwnUserId();

        allow delete: if isDocOwner();
      }

      // Явные подколлекции вместо catch-all (иначе OR обходит isDocOwner)
      match /flashcards/{cardId} {
        allow read, write: if isPathOwner(userId);
      }

      match /tracks/{trackId} {
        allow read, write: if isPathOwner(userId);
      }

      match /meta/{metaId} {
        allow read, write: if isPathOwner(userId);
      }

      match /sync/{syncId} {
        allow read, write: if isPathOwner(userId);
      }
    }

    /**
     * Публичный индекс подборок: publicCollections/{slug}
     * - read: только авторизованные (+ isPublic или свой документ)
     * - write/delete: только владелец (userId == auth.uid)
     */
    match /publicCollections/{slug} {
      allow read: if isSignedIn()
        && (
          resource.data.isPublic == true
          || resource.data.userId == request.auth.uid
        );

      allow create: if createWithOwnUserId()
        && request.resource.data.slug == slug
        && request.resource.data.isPublic == true
        && (
          !request.resource.data.keys().hasAny(['ownerUserId'])
          || request.resource.data.ownerUserId == request.auth.uid
        )
        && (
          !request.resource.data.keys().hasAny(['authorId'])
          || request.resource.data.authorId == request.auth.uid
        );

      allow update: if isDocOwner()
        && keepsOwnUserId()
        && request.resource.data.slug == slug;

      allow delete: if isDocOwner();

      match /books/{bookId} {
        allow read: if publicCollectionReadable(slug)
          || publicCollectionOwned(slug);
        allow create, update, delete: if publicCollectionOwned(slug);
      }
    }

    /**
     * Публичные колоды карточек: publicDecks/{slug}
     * read: авторизованные + isPublic (или свой документ)
     * write: только владелец
     */
    match /publicDecks/{slug} {
      allow read: if isSignedIn()
        && (
          resource.data.isPublic == true
          || resource.data.userId == request.auth.uid
        );

      allow create: if createWithOwnUserId()
        && request.resource.data.slug == slug
        && request.resource.data.isPublic == true
        && (
          !request.resource.data.keys().hasAny(['ownerUserId'])
          || request.resource.data.ownerUserId == request.auth.uid
        )
        && (
          !request.resource.data.keys().hasAny(['authorId'])
          || request.resource.data.authorId == request.auth.uid
        );

      allow update: if isDocOwner()
        && keepsOwnUserId()
        && request.resource.data.slug == slug;

      allow delete: if isDocOwner();
    }

    /**
     * Публичные профили прогресса: publicProfiles/{slug}
     * Без приватных книг — только стрик / слова / неделя.
     */
    match /publicProfiles/{slug} {
      allow read: if isSignedIn()
        && (
          resource.data.isPublic == true
          || resource.data.userId == request.auth.uid
        );

      allow create: if createWithOwnUserId()
        && request.resource.data.slug == slug
        && request.resource.data.isPublic == true
        && (
          !request.resource.data.keys().hasAny(['ownerUserId'])
          || request.resource.data.ownerUserId == request.auth.uid
        )
        && (
          !request.resource.data.keys().hasAny(['authorId'])
          || request.resource.data.authorId == request.auth.uid
        );

      allow update: if isDocOwner()
        && keepsOwnUserId()
        && request.resource.data.slug == slug;

      allow delete: if isDocOwner();
    }
  }
}
